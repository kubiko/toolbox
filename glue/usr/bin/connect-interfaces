#!/bin/bash

help() {
    echo "Helper script for automation tests only!"
    echo "This script can be used to automate interface connection for given snap(s)"
    echo "Unconnected plugs are matched against system slots of the same interface"
    echo "first (regardless of plug/slot name). If there is no system slot, a single"
    echo "slot candidate provided by other snap is used. Otherwise best effort is made."
    echo "use: \$ $(basename "${0}") <snap name> [<snap name>...]"
}

snap_names=()
for a in "$@"
do
    case "${a}" in
    -h | --help)
        help
        exit
        ;;
    *)
        # validate we have valid snap name
        if ! snap list "${a}" 2> /dev/null | awk '{print $1}' | grep -q "^${a}$"; then
            echo -e "'${a}' is not valid snap name"
            help
            exit 1
        fi
        snap_names+=("${a}")
        ;;
    esac
done

if [ ${#snap_names[@]} -eq 0 ]; then
    echo -e "Missing snap name!"
    help
    exit 1
fi

# all plugs and slots (connected and unconnected) in the system
# columns: Interface Plug Slot Notes, system slots are listed as ':<slot>'
all_connections="$(snap connections --all | tail -n +2)"

connect_plug() {
    local snap_name="${1}"
    local iface="${2}"
    local plug="${3}"
    local system_slots other_slots slot

    # system slots implementing the interface, slot name does not have to match
    # interface name (e.g. ':kernel-module-load') nor plug name
    system_slots=$(echo "${all_connections}" \
        | awk -v iface="${iface}" '$1 == iface && $3 ~ /^:/ {print $3}' | sort -u)
    if [ -n "${system_slots}" ]; then
        # prefer slot named after the interface, otherwise take first one
        if echo "${system_slots}" | grep -q -x ":${iface}"; then
            slot=":${iface}"
        else
            slot=$(echo "${system_slots}" | head -n 1)
        fi
        echo -e "\tconnecting '${snap_name}:${plug}' to system slot '${slot}'"
        snap connect "${snap_name}:${plug}" "${slot}"
        return
    fi

    # slots provided by other snaps
    other_slots=$(echo "${all_connections}" \
        | awk -v iface="${iface}" -v snap="${snap_name}" \
            '$1 == iface && $3 != "-" && $3 !~ /^:/ && index($3, snap ":") != 1 {print $3}' \
        | sort -u)
    if [ -n "${other_slots}" ]; then
        if [ "$(echo "${other_slots}" | wc -l)" -eq 1 ]; then
            echo -e "\tTrying slot candidate '${other_slots}' for plug ${snap_name}:${plug}"
            snap connect "${snap_name}:${plug}" "${other_slots}"
        else
            echo -e "\tmultiple slot candidates for plug ${snap_name}:${plug}, skipping:"
            echo "${other_slots}" | sed 's/^/\t\t/'
        fi
        return
    fi

    case "${iface}" in
    system-files | personal-files)
        echo -e "\tconnecting '${snap_name}:${plug}' to implicit slot"
        snap connect "${snap_name}:${plug}"
        ;;
    *)
        echo -e "\tno good candidate found for plug ${snap_name}:${plug} (${iface})"
        ;;
    esac
}

for snap_name in "${snap_names[@]}"
do
    echo -e "Connecting interfaces for ${snap_name}\n"
    # unconnected plugs of the snap: '<interface> <snap>:<plug> -'
    snap connections "${snap_name}" \
        | awk -v snap="${snap_name}" '$3 == "-" && index($2, snap ":") == 1 {sub(/^[^:]*:/, "", $2); print $1, $2}' \
        | while read -r iface plug
    do
        connect_plug "${snap_name}" "${iface}" "${plug}"
    done
done
