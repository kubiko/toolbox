#!/bin/bash

# script version: 1.0

SNAP_TARGETS=(snap snapd snap-bootstrap)
BUILD_EXTENDED="false" # true to enable
SNAP_TARGETS_EXTENDED=(
  snap-update-ns
  snap-preseed
  snap-seccomp
  snapctl
  snapd-aa-prompt-listener
  snapd-aa-prompt-ui
  snapd-apparmor
  snap-exec
  snap-failure
  snap-fde-keymgr
  snap-recovery-chooser
  snap-repair
)
# targets which can't be built for given arch
SNAP_TARGETS_EXCLUDED=()

declare -A SNAP_TAGS
SNAP_TAGS["snap"]="nomanagers"
SNAP_TAGS["snap-bootstrap"]="nomanagers"

BUILD_DIR="${HOME}/snapd-build"
GO_LDFLAGS="-s -w" # flags to strip DWARF, symbol and debug info

set_amd64() {
  export GOARCH=amd64
  export CC=x86_64-linux-gnu-gcc
  export CGO_ENABLED=1
  export FARCH=amd64
}

set_armhf() {
  export GOARCH=arm
  export GOARM=7
  export CGO_ENABLED=1
  export CC=arm-linux-gnueabihf-gcc
  export FARCH=armhf
}

set_arm64() {
  export GOARCH=arm64
  unset GOARM
  export CGO_ENABLED=1
  export CC=aarch64-linux-gnu-gcc
  export FARCH=arm64
}

set_macOS() {
  export GOARCH=arm64
  # export CC=x86_64-linux-gnu-gcc
  export CGO_ENABLED=1
  export FARCH=macOS
  SNAP_TARGETS_EXCLUDED=(snapd snap-seccomp snap-update-ns snap-bootstrap)
  BUILD_DIR="${HOME}/development/snapd"
  SNAP_TAGS["snap"]="nomanagers nosecboot"
}

print_config() {
  echo -e "\nRunning build with following configuration:"
  echo -e "\tGOARCH=${GOARCH}"
  echo -e "\tGOARM=${GOARM}"
  echo -e "\tCC=${CC}"
  echo -e "\tFARCH=${FARCH}"
  echo -e "\tBUILD_DIR=${BUILD_DIR}"
  echo -e "\tSNAP_TARGETS: ${SNAP_TARGETS[*]}"
  echo -e "\tSNAP_TAGS:"
  for t in "${SNAP_TARGETS[@]}"
  do
    if [[ -n "${SNAP_TAGS[${t}]}" ]]; then
      echo -e "\t\t${t}:\t '${SNAP_TAGS[${t}]}'"
    fi
  done
  echo -e "\n"
}

print_help () {
  echo -e "Helper script to compile snap(d) binaries locally\n"
  echo -e "Usage: $0 [architecture] [options]\n"
  echo -e "Parameters:"
  echo -e "\tArchitecture options: [amd64 | armhf | arm64 | macOS]"
  echo -e "\t\tIf none is supplied, host arch is assumed\n"
  echo -e "\t-all: build also extended set of snapd binaries\n"
  echo -e "\t-build-dir=<path>: directory to store built binaries"
  echo -e "\t\tdefault: ${BUILD_DIR}\n"
  echo -e "\t-help: this help"
}

for line in "$@"
do
  case "${line}" in
    amd64)
      set_amd64
      ;;
    armhf)
      set_armhf
      ;;
    arm64)
      set_arm64
      ;;
    osx | macOS)
      set_macOS
      ;;
    -all | --all)
      BUILD_EXTENDED="true"
      ;;
    -build-dir=* | --build-dir=*)
      BUILD_DIR=${line#*=}
      ;;
    -help | --help | -h)
      print_help
      exit
      ;;
    *)
      echo -e "Wrong parameter: ${line}\n\n"
      print_help
      exit 1
      ;;
    esac
done

# if arch was not set, assume host
if [[ -z "${GOARCH}" ]]; then
  echo -e "\nNo arch defined, assuming host's arch"
  case $(uname -m) in
    arm64)
      set_macOS
      ;;
    aarch64)
      set_arm64
      ;;
    armv7l)
      set_armhf
      ;;
    x86_64)
      set_amd64
      ;;
    *)
      ;;
  esac
fi

if [[ -z "${GOARCH}" ]]; then
  echo "unknown target architecture"
  exit 1
fi

# gather all the build targets
if [[ "${BUILD_EXTENDED}" == "true" ]]; then
  SNAP_TARGETS+=("${SNAP_TARGETS_EXTENDED[@]}")
fi
for e in "${SNAP_TARGETS_EXCLUDED[@]}"
do
  for i in "${!SNAP_TARGETS[@]}"
  do
    [[ "${SNAP_TARGETS[${i}]}" = "${e}" ]] && unset "SNAP_TARGETS[${i}]"
  done
done

print_config

echo "Rebuilding snapd components:"
GOPATH="${GOPATH:-$(go env GOPATH)}"
pushd "${GOPATH}/src/github.com/snapcore/snapd" || exit 1
./mkversion.sh
mkdir -p "${BUILD_DIR}"
for t in "${SNAP_TARGETS[@]}"
do
  [[ -f "${BUILD_DIR}/${t}.${FARCH}" ]] && rm "${BUILD_DIR}/${t}.${FARCH}"
  tag="${SNAP_TAGS[${t}]}"
  if [[ -z "${tag}" ]]; then
    printf "\tBuilding: %-15s\t go build -mod=vendor  -buildmode=pie -o ${BUILD_DIR}/${t}.${FARCH} -ldflags \"${GO_LDFLAGS}\" github.com/snapcore/snapd/cmd/${t}\n" "${t}"
    go build -mod=vendor  -buildmode=pie -o "${BUILD_DIR}/${t}.${FARCH}" -ldflags "${GO_LDFLAGS}" "github.com/snapcore/snapd/cmd/${t}"
  else
    printf "\tBuilding: %-15s\t go build -mod=vendor  -buildmode=pie -tags ${tag} -ldflags \"${GO_LDFLAGS}\"  -o ${BUILD_DIR}/${t}.${FARCH} github.com/snapcore/snapd/cmd/${t}\n" "${t}"
    go build -mod=vendor  -buildmode=pie -tags "${tag}" -o "${BUILD_DIR}/${t}.${FARCH}" -ldflags "${GO_LDFLAGS}" "github.com/snapcore/snapd/cmd/${t}"
  fi
  OUT=$?
  if [[ "${OUT}" -ne 0 ]]; then
    echo "Build of ${t} failed... bailing out"
    exit 1
  fi
done

echo -e "Building finished\n"

echo -e "Double checking if build was successful and we have all needed binaries\n"
for t in "${SNAP_TARGETS[@]}"
do
  if [[ ! -e "${BUILD_DIR}/${t}.${FARCH}" ]]; then
    echo "Build failed... bailing out"
    exit 1
  else
    printf "successfully built %-15s \t ${BUILD_DIR}/${t}.${FARCH}\n" "${t}"
  fi
done

popd > /dev/null || exit 1
