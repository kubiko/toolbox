#!/bin/bash

UNSQUASHFS="/snap/toolbox/current/usr/bin/unsquashfs"
MKSQUASHFS="/snap/toolbox/current/usr/bin/mksquashfs"

print_help() {
  echo -e "Reconstruct target snap from source snap and delta"
  echo -e "Arguments:"
  echo -e "\t--source | -s: source snap"
  echo -e "\t--delta  | -d: delta between source and target snap"
  echo -e "\t--target | -t: recreated target snap"
  echo -e ""
  echo -e "Usage:"
  echo -e "\t$(basename "${0}") --source <source snap file> --delta <delta file> --output <output file>"
  echo -e ""
  echo -e "Example:"
  echo -e "\t$(basename "${0}") --source core22_2134.snap --delta delta-core22-2134-2140 --target core22_2140.snap"
  exit
}

# parse passed parameters
while [ "$1" != "" ];
do
  case $1 in
    --source | -s)
      SOURCE_SNAP=${2}
      ;;
    --delta  | -d)
      DELTA=${2}
      ;;
    --target | -t)
      TARGET_SNAP=${2}
      ;;
    --help | -h)
      print_help
      ;;
    *)
      print_help
      ;;
  esac
  shift; shift
done

if [ -z "${SOURCE_SNAP}" ] || [ -z "${DELTA}" ] || [ -z "${TARGET_SNAP}" ]; then
  echo "Missing some of the required parameters"
  print_help
fi

source_snap_pipe=$(mktemp -u /tmp/snap-delta-XXXXXX)
delta_pipe=$(mktemp -u /tmp/snap-delta-XXXXXX)
rm -rf "${source_snap_pipe}" "${delta_pipe}"
mkfifo "${source_snap_pipe}" "${delta_pipe}"
"${UNSQUASHFS}" -n -pf "${source_snap_pipe}" "${SOURCE_SNAP}" &
dd if="${DELTA}" of="${delta_pipe}" status=none bs=512 skip=1 &

# get fs time stamp first
fstimeint=$(od -A n -t u8 -N 8 "${DELTA}" | xargs)
fs_time_stamp=$(date +"%a %b %e %T %Y" -d @${fstimeint})

# snapd and base snaps are without '-no-xattrs' argument
snap_name=$("${UNSQUASHFS}" -cat "${SOURCE_SNAP}" /meta/snap.yaml | awk -F ': ' '{if ($1 == "name") {print $2}}')
case "${snap_name}" in
  "snapd" | "core" | "core18" | "core20" | "core22" | "core24" | "core26")
    xdelta3 -f -d -s "${source_snap_pipe}" "${delta_pipe}" | "${MKSQUASHFS}" - "${TARGET_SNAP}" -pf - -no-progress -quiet -noappend -comp xz -no-fragments -mkfs-time "${fs_time_stamp}"
    ;;
  *)
    xdelta3 -f -d -s "${source_snap_pipe}" "${delta_pipe}" | "${MKSQUASHFS}" - "${TARGET_SNAP}" -pf - -no-progress -quiet -noappend -comp xz -no-fragments -no-xattrs -mkfs-time "${fs_time_stamp}"
    ;;
esac

rm "${source_snap_pipe}" "${delta_pipe}"
