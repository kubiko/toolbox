#!/bin/bash

UNSQUASHFS="/snap/toolbox/current/usr/bin/unsquashfs"
MKSQUASHFS="/snap/toolbox/current/usr/bin/mksquashfs"

print_help() {
  echo -e "Reconstruct target snap from source and delta"
  echo -e "Timestamp argument is required in order to make recreated snap identiall to the original one"
  echo -e "Usage:"
  echo -e "\t$(basename "${0}") --source <source snap file> --delta <delta file> --output <output file> --mkfs-time <time stamp of the target snap>"
  echo -e ""
  echo -e "Example: $(basename "${0}") --source core22_2134.snap --delta delta-core22-2134-2140 --output core22_2140.snap --mkfs-time \"Tue Sep 23 04:47:57 2025\""
  exit
}

# parse passed parameters
while [ "$1" != "" ];
do
  case $1 in
    --source | -s)
      SOURCE_SNAP=${2}
      ;;
    --delta  | -d)
      DELTA=${2}
      ;;
    --output | -o)
      TARGET_SNAP=${2}
      ;;
    --mkfs-time | -t)
      CREATION_TIME=${2}
      ;;
    --help | -h)
      print_help
      ;;
    *)
      print_help
      ;;
  esac
  shift; shift
done

if [ -z "${SOURCE_SNAP}" ] || [ -z "${DELTA}" ] || [ -z "${TARGET_SNAP}" ] || [ -z "${CREATION_TIME}" ]; then
  echo "Missing some of the required parameters"
  print_help
fi

source_snap_pipe=$(mktemp -u /tmp/snap-delta-XXXXXX)
rm -rf "${source_snap_pipe}"
mkfifo "${source_snap_pipe}"
"${UNSQUASHFS}" -n -pf "${source_snap_pipe}" "${SOURCE_SNAP}" &

# snapd and base snaps are without '-no-xattrs' argument
snap_name=$("${UNSQUASHFS}" -cat "${SOURCE_SNAP}" /meta/snap.yaml | awk -F ': ' '{if ($1 == "name") {print $2}}')
case "${snap_name}" in
  "snapd" | "core" | "core18" | "core20" | "core22" | "core24" | "core26")
    xdelta3 -f -d -s "${source_snap_pipe}" "${DELTA}" | "${MKSQUASHFS}" - "${TARGET_SNAP}" -pf - -no-progress -quiet -noappend -comp xz -no-fragments -mkfs-time "${CREATION_TIME}"
    ;;
  *)
    xdelta3 -f -d -s "${source_snap_pipe}" "${DELTA}" | "${MKSQUASHFS}" - "${TARGET_SNAP}" -pf - -no-progress -quiet -noappend -comp xz -no-fragments -no-xattrs -mkfs-time "${CREATION_TIME}"
    ;;
esac

rm "${source_snap_pipe}"
