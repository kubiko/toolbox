#!/bin/bash

[ -z "${ARCH_TRIPLET}" ] && ARCH_TRIPLET=$(sed -n 's/.*ARCH_TRIPLET: \(.*\)/\1/p' /snap/toolbox/current/meta/snap.yaml)
SNAP_PATH="/snap/${SNAP_INSTANCE_NAME}/current"

echo -e "\n# Updating ~/.bashrc with folloving lines" >&2
# print each line twice, one to stdout and once to stderr
echo "# start of modifications done by toolbox snap" >&2
echo "# start of modifications done by toolbox snap"
echo "SNAP_TOOLBOX=\"${SNAP_PATH}\"" >&2
echo "SNAP_TOOLBOX=\"${SNAP_PATH}\""
echo "export PATH=\"\${SNAP_TOOLBOX}/usr/bin:\${SNAP_TOOLBOX}/usr/sbin:\${PATH}\"" >&2
echo "export PATH=\"\${SNAP_TOOLBOX}/usr/bin:\${SNAP_TOOLBOX}/usr/sbin:\${PATH}\""
echo "export LD_LIBRARY_PATH=\"/usr/lib:/usr/lib/${ARCH_TRIPLET}:\${SNAP_TOOLBOX}/usr/lib:\${SNAP_TOOLBOX}/usr/lib/${ARCH_TRIPLET}\"" >&2
echo "export LD_LIBRARY_PATH=\"/usr/lib:/usr/lib/${ARCH_TRIPLET}:\${SNAP_TOOLBOX}/usr/lib:\${SNAP_TOOLBOX}/usr/lib/${ARCH_TRIPLET}\""
echo "export PERL5LIB=\"\${SNAP_TOOLBOX}/usr/lib/${ARCH_TRIPLET}/perl:\${SNAP_TOOLBOX}/usr/lib/${ARCH_TRIPLET}/perl-base:\${SNAP_TOOLBOX}/usr/share/perl\"" >&2
echo "export PERL5LIB=\"\${SNAP_TOOLBOX}/usr/lib/${ARCH_TRIPLET}/perl:\${SNAP_TOOLBOX}/usr/lib/${ARCH_TRIPLET}/perl-base:\${SNAP_TOOLBOX}/usr/share/perl\""
echo "alias ssudo='sudo -E env \"PATH=\$PATH\" \"PERL5LIB=\$PERL5LIB\" \"LD_LIBRARY_PATH=\$LD_LIBRARY_PATH\"'" >&2
echo "alias ssudo='sudo -E env \"PATH=\$PATH\" \"PERL5LIB=\$PERL5LIB\" \"LD_LIBRARY_PATH=\$LD_LIBRARY_PATH\"'"
echo "alias sudo='ssudo '" >&2
echo "alias sudo='ssudo '"
echo "export XDG_DATA_DIRS=/usr/local/share:/usr/share:/snap/snapd/current/usr/share:\${SNAP_TOOLBOX}/usr/share" >&2
echo "export XDG_DATA_DIRS=/usr/local/share:/usr/share:/snap/snapd/current/usr/share:\${SNAP_TOOLBOX}/usr/share"
echo "source \${SNAP_TOOLBOX}/etc/profile.d/bash_completion.sh" >&2
echo "source \${SNAP_TOOLBOX}/etc/profile.d/bash_completion.sh"
echo "source \${SNAP_TOOLBOX}/usr/bin/snapcraft-lxd-wrapper" >&2
echo "source \${SNAP_TOOLBOX}/usr/bin/snapcraft-lxd-wrapper"
echo "alias vim='vim.basic'" >&2
echo "alias vim='vim.basic'"
echo "alias file='file -m \${SNAP_TOOLBOX}/usr/share/misc/magic.mgc'" >&2
echo "alias file='file -m \${SNAP_TOOLBOX}/usr/share/misc/magic.mgc'"
echo "export PYTHONPATH=\"\${SNAP_TOOLBOX}/usr/lib/python3/dist-packages\"" >&2
echo "export PYTHONPATH=\"\${SNAP_TOOLBOX}/usr/lib/python3/dist-packages\""
echo "# end of modifications done by toolbox snap" >&2
echo "# end of modifications done by toolbox snap"
